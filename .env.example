# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (used by compose.yaml; must match DATABASE_URL)
POSTGRES_DB=bookfriend
POSTGRES_USER=bookfriend
POSTGRES_PASSWORD=change-me

# Services (local dev: Postgres and Redis run in Docker, ports published to localhost)
DATABASE_URL=postgres://bookfriend:change-me@localhost:5432/bookfriend
REDIS_URL=redis://localhost:6379/0
